# Local database (docker-compose): postgresql://revisionmaths:revisionmaths@localhost:5433/revisionmaths
# Production (Neon): get the connection string from the Neon dashboard (with ?sslmode=require)
DATABASE_URL="postgresql://revisionmaths:revisionmaths@localhost:5433/revisionmaths"

# Admin mode password (change it in production)
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie (long random string)
SESSION_SECRET="change-this-to-a-long-random-string"

# Real Neon credentials live in .env.neon (local file, gitignored, never committed).
# To point local dev at Neon temporarily, copy its content into .env.
# For an actual deployment, configure these variables on the hosting platform instead.
